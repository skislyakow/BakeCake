# Скопируй в .env и заполни под своё окружение: cp .env.example .env
# Читает settings.py (environs), файл лежит в корне репозитория.
# Значение, заданное переменной окружения, важнее .env — на сервере так
# работает systemd-юнит (EnvironmentFile=), см. deploy/.
# Файл в git не попадает, см. .gitignore.

# Обязательно: без непустого SECRET_KEY проект не запустится.
# Сгенерировать: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# В кавычках: в ключе бывают # и спецсимволы, без кавычек значение может
# молча обрезаться по символу #.
SECRET_KEY=

# Отладка: true/false, True/False, TRUE/FALSE, yes/no, 1/0.
# По умолчанию выключена, если переменная не задана.
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Телефон магазина — в шапке и в подвале сайта, плюс в тексте заказа.
# В кавычках: значение с пробелами, systemd-юнит читает .env как EnvironmentFile.
SHOP_PHONE="8 (495) 000-00-00"

# ЮKassa. Пока нет ИП/самозанятости и ключей — оставь пустым, работает
# ручное подтверждение оплаты в админке (.agents/PLAN.md, раздел 15, пункт 1).
YOO_SHOP_ID=
YOO_SECRET_KEY=
# Адрес сайта — используется в return_url после оплаты (юзер возвращается в ЛК).
SITE_URL=https://bakecake.kislyakov.pro

# JivoSite — ID сайта из личного кабинета. Пусто: виджет просто не ставится.
JIVO_SITE_ID=HdmscC2Col

# Вход на сайт: demo | off | call.
# demo — любой номер сразу создаёт пользователя и сессию (текущий режим);
# off  — вход через сайт выключен, /admin/ продолжает работать;
# call — номер подтверждается звонком через Звонок™, сессия открывается
#        только после подписанного postback. На проде включай call только
#        с заполненными ZVONOK_* ниже.
AUTH_MODE=demo

# Звонок™ (подтверждение номера). Ключи и URL метода — из личного кабинета.
# Имена полей postback и схема подписи сверяются с документацией провайдера;
# по умолчанию ждём HMAC-SHA256 тела запроса в заголовке X-Zvonok-Signature.
ZVONOK_API_KEY=
ZVONOK_API_SECRET=
ZVONOK_VERIFY_URL=
ZVONOK_SIGNATURE_HEADER=X-Zvonok-Signature
# Номер, который сайт показывает клиенту: «позвоните на этот номер».
ZVONOK_VERIFY_NUMBER="8 800 000-00-00"

# Ожидание подтверждения: срок жизни токена и лимиты против перебора.
PHONE_CONFIRM_TTL_MINUTES=5
PHONE_CONFIRM_MAX_PENDING=3
PHONE_CONFIRM_MAX_PER_HOUR=10
PHONE_CONFIRM_MAX_ATTEMPTS=5
