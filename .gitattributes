* text=auto

# Скрипты и юниты запускаются на сервере от root: CRLF в shebang даёт
# "bad interpreter", а CRLF в unit-файле systemd — ошибку парсинга.
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf

# Шрифты и картинки из макета: git не должен пытаться их нормализовать.
*.png binary
*.otf binary
*.ttf binary
